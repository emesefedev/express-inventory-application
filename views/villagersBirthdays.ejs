<html>
  <%- include("head", {title}) %>

  <body class="bg-[#B0D0D3]">
    <%- include("navbar", {links}) %>
    <main class="p-4">
      <%- include("title", {title, capitalize}) %>
      <div class="grid grid-cols-7 gap-4 mt-4 p-8">
        <%  for (let i = 1; i <= month.totalDays; i++) {  %>
          <div  
            class="flex justify-center items-center bg-[#EC9192] border border-[#EC9192] border-2 rounded-lg h-8 text-white"> 
              <p> <%= i %>  </p> 
        </div>
        <% } %>
      </div>
    </main>
  </body>
</html>